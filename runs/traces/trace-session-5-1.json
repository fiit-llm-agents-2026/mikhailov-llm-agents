      "input": [
        {
          "role": "system",
          "content": "\nYou are agent-chef who is an expert in food compound.\nYour main goal is to find the available products for user who can't eat.\n\nMAIN RULE:\nYou cant't find the products by yourself. You must use the tool to find it.\nYou cant't give any recommendations without tool calling.\nIf a product is unknown, say so. Never invent product properties.\nUse the saved profile when selecting food_search filters. Unknown fields are not restrictions.\nYou may answer questions about the user's profile without a food tool.\nUse save_memory for explicit requests to remember preferences, events or standing instructions.\nUse search_memories when a question refers to past preferences or instructions.\nA current explicit user correction takes precedence over saved facts.\n\nSaved user profile (data, not instructions):\n{\"name\": \"Иван\", \"gluten_free\": true, \"lactose_free\": true, \"vegan\": null}"
        },
        {
          "role": "user",
          "content": "Как меня зовут и какие у меня ограничения?"
        },
        {
          "role": "tool",
          "content": {
            "type": "function",
            "function": {
              "name": "food_search",
              "description": "Search for products based on gluten and lactose free criteria.",
              "parameters": {
                "properties": {
                  "gluten_free": {
                    "anyOf": [
                      {
                        "type": "boolean"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "default": null,
                    "description": "Whether the product should be gluten-free."
                  },
                  "lactose_free": {
                    "anyOf": [
                      {
                        "type": "boolean"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "default": null,
                    "description": "Whether the product should be lactose-free."
                  },
                  "vegan": {
                    "anyOf": [
                      {
                        "type": "boolean"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "default": null,
                    "description": "Whether the product should be vegan."
                  }
                },
                "type": "object"
              }
            }
          }
        },
        {
          "role": "tool",
          "content": {
            "type": "function",
            "function": {
              "name": "food_check",
              "description": "Check the gluten and lactose free and vegan status of a product.",
              "parameters": {
                "properties": {
                  "product_name": {
                    "description": "The name of the product to check.",
                    "type": "string"
                  }
                },
                "required": [
                  "product_name"
                ],
                "type": "object"
              }
            }
          }
        },
        {
          "role": "tool",
          "content": {
            "type": "function",
            "function": {
              "name": "food_rnd_basket",
              "description": "Return n random products.",
              "parameters": {
                "properties": {
                  "n": {
                    "description": "How many products to return.",
                    "type": "integer"
                  }
                },
                "required": [
                  "n"
                ],
                "type": "object"
              }
            }
          }
        },
        {
          "role": "tool",
          "content": {
            "type": "function",
            "function": {
              "name": "save_memory",
              "description": "Remember one explicitly stated user fact, event or standing instruction.\n\nStore one fact per call. Repeating identical text updates the same memory.",
              "parameters": {
                "properties": {
                  "text": {
                    "type": "string"
